{
  "name": "@queryloom/library",
  "version": "0.1.0",
  "description": "Dashboard data library for Queryloom",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "compile": "tsup src/index.ts --format esm --clean && tsc -p tsconfig.json --emitDeclarationOnly --outDir dist",
    "prepack": "bun run compile",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "^1.29.0",
    "svelte": "^5.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
