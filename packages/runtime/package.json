{
  "name": "@queryloom/runtime",
  "version": "0.1.0",
  "description": "Browser-local DuckDB-Wasm runtime and Svelte visualization for Queryloom",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./RevenueTrend.svelte": "./dist/RevenueTrend.svelte"
  },
  "files": ["dist"],
  "scripts": {
    "compile": "tsup src/index.ts --format esm --clean && tsc -p tsconfig.json --emitDeclarationOnly --outDir dist && cp src/*.svelte dist/",
    "prepack": "bun run compile",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "^1.29.0",
    "d3-scale": "^4.0.2",
    "layercake": "^10.0.3",
    "svelte": "^5.16.0"
  },
  "devDependencies": {
    "@types/d3-scale": "^4.0.9",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
